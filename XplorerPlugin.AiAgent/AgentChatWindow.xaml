<UserControl x:Class="XplorerPlugin.AiAgent.AgentChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:XplorerPlugin.AiAgent.Chat"
             MinWidth="300">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type chat:ChatMessageViewModel}">
            <Border Padding="8,6" Margin="4,3" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{Binding AuthorBrush}" DockPanel.Dock="Left" />
                        <TextBlock x:Name="StreamingHint" Text=" ..." Foreground="Gray" FontSize="11"
                                   Visibility="{Binding IsStreaming, Converter={x:Static chat:BoolToVisibilityConverter.Instance}}" />
                    </DockPanel>
                    <RichTextBox Margin="0,3,0,0" Padding="0" BorderThickness="0"
                                 Background="Transparent" IsReadOnly="True" IsUndoEnabled="False"
                                 IsTabStop="False" SpellCheck.IsEnabled="False"
                                 VerticalScrollBarVisibility="Disabled"
                                 chat:MarkdownAttach.Markdown="{Binding Text}" />
                    <Button Content="Open report" Margin="0,6,0,0" Padding="10,3" HorizontalAlignment="Left"
                            Visibility="{Binding ReportPath, Converter={x:Static chat:NullToVisibilityConverter.Instance}}"
                            Click="OpenReportClick" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Grid.Row="0" Margin="6,5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Clear" Padding="8,3" Margin="4,0,0,0" Click="ClearClick"
                        ToolTip="Clear the conversation" />
                <Button Content="Settings" Padding="8,3" Margin="4,0,0,0" Click="SettingsClick"
                        ToolTip="AI agent settings (endpoint, API key, model)" />
            </StackPanel>
            <TextBlock x:Name="ModelStatusLabel" Text="No model open" VerticalAlignment="Center"
                       Foreground="#555" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- chat messages -->
        <ListBox x:Name="MessagesList" Grid.Row="1" Margin="4,0"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Messages, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- tool activity -->
        <TextBlock x:Name="ToolActivityText" Grid.Row="2" Margin="10,2" Foreground="Gray" FontSize="11"
                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

        <!-- input -->
        <Grid Grid.Row="3" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" AcceptsReturn="True" MaxHeight="120"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Padding="4"
                     KeyDown="InputKeyDown"
                     ToolTip="Enter to send, Shift+Enter for a new line" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="SendButton" Content="Send" Width="70" Margin="0,0,4,0" Padding="8,4"
                        VerticalAlignment="Top" Click="SendClick" />
                <Button x:Name="StopButton" Content="Stop" Width="60" Padding="8,4"
                        VerticalAlignment="Top" Click="StopClick" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="10,2,10,5" Foreground="#777" FontSize="11"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
