<Window x:Class="XplorerPlugin.AiAgent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Agent Settings"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Endpoint base URL:" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="BaseUrlBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="API key (optional):" VerticalAlignment="Center" Margin="0,4,8,4" />
            <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="ModelBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature:" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="TemperatureBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Max tool iterations:" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="MaxIterBox" Grid.Row="4" Grid.Column="1" Margin="0,4" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Report folder:" VerticalAlignment="Center" Margin="0,4,8,4" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReportFolderBox" Grid.Column="0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="8,3" Click="BrowseClick" />
            </Grid>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Extra instructions:" VerticalAlignment="Top" Margin="0,8,8,4" />
            <TextBox x:Name="ExtraPromptBox" Grid.Row="6" Grid.Column="1" Margin="0,4" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     ToolTip="Optional system prompt additions for the agent" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Click="SaveClick" />
            <Button Content="Cancel" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
